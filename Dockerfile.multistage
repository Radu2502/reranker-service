# Builder: aici stă uv, cache-ul de instalare și tot ce nu ne trebuie la runtime.
FROM python:3.13-slim AS builder

# Versiune pinnată: un build peste trei luni folosește același uv.
COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

# Același WORKDIR ca în stagiul final — venv-ul are căi absolute înăuntru.
WORKDIR /app

# Dependențele separat de cod: o modificare în main.py nu invalidează cache-ul.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

# Modelul descărcat aici, copiat mai jos: pornire fără rețea.
ENV HF_HOME=/opt/hf
RUN uv run python -c "\
from sentence_transformers import CrossEncoder; \
CrossEncoder('cross-encoder/mmarco-mMiniLMv2-L12-H384-v1')"

# Sursa intra ultima, ca modelul si cele 71 de pachete sa ramana cache-uite.
# README.md e obligatoriu: pyproject are `readme = "README.md"`, iar hatchling
# citeste metadatele la build — fara el, `uv sync` cade.
COPY README.md ./
COPY src/ ./src/

# Instaleaza pachetul `reranker` in venv (editable, .pth -> /app/src). Pasul de
# mai sus folosea --no-install-project, deci fara asta venv-ul copiat mai jos
# n-ar contine pachetul si `uvicorn reranker.main:app` ar da ModuleNotFoundError.
RUN uv sync --locked --no-dev


# Runtime: imagine curată, primește doar artefactele finite.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/opt/hf

# Venv-ul în PATH înlocuiește `uv run` — uv nu mai ajunge în imagine.
ENV PATH="/app/.venv/bin:$PATH"

ENV HF_HUB_OFFLINE=1

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /opt/hf /opt/hf

# Sursa vine din builder, nu din context: garanteaza ca e exact ce s-a instalat.
# Calea trebuie sa ramana /app/src — acolo arata .pth-ul din venv.
# Doar codul de producție: fără tests/, conftest.py, pyproject.toml.
COPY --from=builder /app/src /app/src

EXPOSE 8002

CMD ["opentelemetry-instrument", "uvicorn", "reranker.main:app", "--host", "0.0.0.0", "--port", "8002", "--no-access-log"]